{
  "manifest_version": 3,
  "name": "AutoSubmit",
  "version": "2.0.0",
  "description": "Batch-submits your product to free AI directories: opens each site, fills the form, picks the free plan and submits. All data stays in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AutoSubmit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "src/manage.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/sites.js",
        "src/i18n.js",
        "src/engine.js",
        "src/runner.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
